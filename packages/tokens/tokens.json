{
  "$description": "Design tokens da MIP. Fonte: arquivo Figma Grupo-8 (variáveis e estilos de texto). Rode `npm run tokens` para gerar dist/tokens.css e dist/tokens.js. O bloco \"legacy\" mantém os nomes antigos só para as telas do app que ainda não foram refeitas; apague-o quando elas forem.",
  "color": {
    "primitive": {
      "neutral-black": "#000000",
      "neutral-900": "#0a0a0a",
      "neutral-850": "#141414",
      "neutral-800": "#212121",
      "neutral-700": "#393939",
      "neutral-600": "#5e5e5e",
      "neutral-500": "#8f8f8f",
      "neutral-300": "#c4c7c5",
      "neutral-200": "#e3e3e3",
      "neutral-100": "#f2f2f2",
      "neutral-white": "#ffffff"
    },
    "semantic": {
      "bg-page": "#000000",
      "bg-surface": "#141414",
      "bg-surface-raised": "#212121",
      "bg-panel": "#212121",
      "bg-tile": "#393939",
      "bg-input": "#212121",
      "text-primary": "#ffffff",
      "text-secondary": "#c4c7c5",
      "text-muted": "#8f8f8f",
      "text-on-panel": "#ffffff",
      "text-on-panel-muted": "#c4c7c5",
      "text-accent": "#c4c7c5",
      "border-default": "#393939",
      "border-strong": "#8f8f8f",
      "action-primary-bg": "#ffffff",
      "action-primary-text": "#000000",
      "status-ok": "#6fd08c",
      "status-ok-bg": "#17331f",
      "status-warn": "#f0c060",
      "status-warn-bg": "#3a2e12",
      "status-bad": "#ff8a80",
      "status-bad-bg": "#3d1a18"
    },
    "legacy": {
      "bg": "var(--color-bg-page)",
      "surface": "var(--color-bg-surface)",
      "surface-2": "var(--color-bg-surface-raised)",
      "ink": "var(--color-text-primary)",
      "muted": "var(--color-text-secondary)",
      "line": "var(--color-border-default)",
      "accent": "var(--color-action-primary-bg)",
      "accent-ink": "var(--color-action-primary-text)",
      "accent-soft": "var(--color-bg-surface-raised)",
      "ok": "var(--color-status-ok)",
      "ok-soft": "var(--color-status-ok-bg)",
      "warn": "var(--color-status-warn)",
      "warn-soft": "var(--color-status-warn-bg)",
      "pend": "var(--color-text-secondary)",
      "pend-soft": "var(--color-bg-surface-raised)",
      "bad": "var(--color-status-bad)",
      "bad-soft": "var(--color-status-bad-bg)",
      "hero-bg": "var(--color-bg-surface-raised)",
      "hero-ink": "var(--color-text-primary)",
      "hero-muted": "var(--color-text-secondary)",
      "toast-bg": "var(--color-bg-tile)",
      "toast-ink": "var(--color-text-primary)"
    }
  },
  "font": {
    "family": {
      "base": "'Montserrat', sans-serif"
    },
    "style": {
      "$description": "Estilos de texto do Figma. size em px (o build gera rem), line = entrelinha em proporção, tracking = letterSpacing do Figma em % (o build gera em = valor/100).",
      "v2-display-hero":     { "size": 48, "line": 1.15, "weight": 500, "tracking": 2 },
      "v2-hero-mobile":      { "size": 34, "line": 1.18, "weight": 500, "tracking": 2 },
      "v2-heading-h2":       { "size": 34, "line": 1.25, "weight": 500, "tracking": 1 },
      "v2-heading-h2-mobile":{ "size": 24, "line": 1.28, "weight": 500, "tracking": 1 },
      "v2-heading-h3":       { "size": 30, "line": 1.3,  "weight": 500, "tracking": 1 },
      "v2-heading-h3-mobile":{ "size": 22, "line": 1.3,  "weight": 500, "tracking": 1 },
      "v2-card-title":       { "size": 19, "line": 1.3,  "weight": 500, "tracking": 1 },
      "v2-stat":             { "size": 40, "line": 1.2,  "weight": 300, "tracking": 0 },
      "v2-name":             { "size": 13, "line": 1.3,  "weight": 500, "tracking": 8 },
      "v2-body":             { "size": 14, "line": 1.75, "weight": 400, "tracking": 0 },
      "v2-body-small":       { "size": 12, "line": 1.75, "weight": 400, "tracking": 0 },
      "v2-eyebrow":          { "size": 11, "line": 1.4,  "weight": 500, "tracking": 18 },
      "v2-caption":          { "size": 10, "line": 1.4,  "weight": 500, "tracking": 12 },
      "v2-link":             { "size": 11, "line": 1.3,  "weight": 500, "tracking": 14 },
      "v2-nav":              { "size": 11, "line": 1,    "weight": 600, "tracking": 4 },
      "v2-button":           { "size": 11, "line": 1,    "weight": 600, "tracking": 12 },
      "v2-site-eyebrow-12":  { "size": 12, "line": 1.4,  "weight": 500, "tracking": 18 },
      "v2-site-body-16":     { "size": 16, "line": 1.65, "weight": 400, "tracking": 0 },
      "v2-site-small-14":    { "size": 14, "line": 1.65, "weight": 400, "tracking": 0 },
      "site-title-28":      { "size": 28, "line": 1.3,  "weight": 500, "tracking": 1 },
      "site-card-title-18": { "size": 18, "line": 1.3,  "weight": 500, "tracking": 1 },
      "site-item-title-16": { "size": 16, "line": 1.3,  "weight": 500, "tracking": 1 },
      "site-lead-20":       { "size": 20, "line": 1.6,  "weight": 500, "tracking": 0 },
      "site-hero-body-16":  { "size": 16, "line": 1.75, "weight": 400, "tracking": 0 },
      "site-step-30":       { "size": 30, "line": 1.2,  "weight": 300, "tracking": 0 },
      "site-title-22":      { "size": 22, "line": 1.3,  "weight": 500, "tracking": 1 },
      "site-hero-30":       { "size": 30, "line": 1.18, "weight": 500, "tracking": 2 },
      "site-lead-16":       { "size": 16, "line": 1.75, "weight": 500, "tracking": 0 },
      "site-hero-body-14":  { "size": 14, "line": 1.75, "weight": 400, "tracking": 0 },
      "site-stat-28":       { "size": 28, "line": 1.2,  "weight": 300, "tracking": 0 },
      "site-nav-18":         { "size": 18, "line": 1,    "weight": 500, "tracking": 4 },
      "site-cta-16":         { "size": 16, "line": 1,    "weight": 700, "tracking": 12 },
      "app-title":           { "size": 28, "line": 1.25, "weight": 700, "tracking": -1 },
      "app-title-2":         { "size": 22, "line": 1.28, "weight": 700, "tracking": 0 },
      "app-title-3":         { "size": 17, "line": 1.3,  "weight": 600, "tracking": 0 },
      "app-body":            { "size": 15, "line": 1.5,  "weight": 400, "tracking": 0 },
      "app-small":           { "size": 13, "line": 1.5,  "weight": 400, "tracking": 0 },
      "app-caption":         { "size": 12, "line": 1.4,  "weight": 500, "tracking": 0 },
      "app-button":          { "size": 14, "line": 1,    "weight": 600, "tracking": 0 }
    },
    "text": {
      "$description": "Legado: escala do iOS/macOS usada pelas telas do app que ainda não foram refeitas. Valores em px; o build gera rem.",
      "large-title": { "size": 34, "line": 41, "weight": 700, "tracking": "-0.02em", "mac": [26, 32] },
      "title-1":     { "size": 28, "line": 34, "weight": 700, "tracking": "-0.015em", "mac": [22, 26] },
      "title-2":     { "size": 22, "line": 28, "weight": 700, "tracking": "-0.01em", "mac": [17, 22] },
      "title-3":     { "size": 20, "line": 25, "weight": 600, "tracking": "0", "mac": [15, 20] },
      "headline":    { "size": 17, "line": 22, "weight": 700, "tracking": "0", "mac": [13, 16] },
      "body":        { "size": 17, "line": 22, "weight": 400, "tracking": "0", "mac": [13, 16] },
      "callout":     { "size": 16, "line": 21, "weight": 400, "tracking": "0", "mac": [12, 15] },
      "subhead":     { "size": 15, "line": 20, "weight": 400, "tracking": "0", "mac": [11, 14] },
      "footnote":    { "size": 13, "line": 18, "weight": 400, "tracking": "0", "mac": [10, 13] },
      "caption-1":   { "size": 12, "line": 16, "weight": 400, "tracking": "0", "mac": [10, 13] },
      "caption-2":   { "size": 11, "line": 13, "weight": 400, "tracking": "0", "mac": [10, 13] }
    }
  },
  "spacing": {
    "sm": "8px",
    "md": "16px",
    "lg": "24px",
    "xl": "32px",
    "2xl": "48px",
    "3xl": "64px",
    "4xl": "96px",
    "5xl": "128px"
  },
  "radius": {
    "md": "8px",
    "lg": "16px",
    "xl": "24px",
    "2xl": "32px",
    "full": "999px",
    "sm": "var(--radius-md)",
    "pill": "var(--radius-full)"
  },
  "effect": {
    "$description": "Glass/Header: no Figma o desfoque de fundo tem raio 28, que equivale a blur(14px) no CSS.",
    "glass-header-blur": "14px",
    "glass-header-fill": "linear-gradient(rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.07)), linear-gradient(rgba(10, 10, 10, 0.35), rgba(10, 10, 10, 0.35))",
    "glass-header-border": "rgba(255, 255, 255, 0.28)",
    "glass-header-shadow": "inset 0 1px 0 rgba(255, 255, 255, 0.35), 0 10px 30px rgba(0, 0, 0, 0.35)",
    "glass-cta-border": "rgba(255, 255, 255, 0.45)",
    "ghost-hover-fill": "rgba(255, 255, 255, 0.14)"
  },
  "space": {
    "0": "0px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px"
  },
  "shadow": {
    "soft": "0 18px 46px rgba(0,0,0,.18)",
    "float": "0 24px 56px rgba(0,0,0,.3)"
  },
  "size": {
    "control": "40px",
    "touch": "44px",
    "page": "1160px",
    "read": "820px",
    "question": "560px",
    "side": "340px",
    "gutter": "16px"
  }
}
