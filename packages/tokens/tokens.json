{
  "$description": "Design tokens da MIP. Fonte única de cores, tipografia, espaçamento, raios e sombras. Rode `npm run tokens` para gerar dist/tokens.css e dist/tokens.js.",
  "color": {
    "dark": {
      "bg": "#0d0d0d",
      "surface": "#191919",
      "surface-2": "#292929",
      "ink": "#f5f5f5",
      "muted": "#b5b5b5",
      "line": "#505050",
      "accent": "#f5f5f5",
      "accent-ink": "#101010",
      "accent-soft": "#303030",
      "ok": "#6fd08c",
      "ok-soft": "#17331f",
      "warn": "#f0c060",
      "warn-soft": "#3a2e12",
      "pend": "#c9c9c9",
      "pend-soft": "#292929",
      "bad": "#ff8a80",
      "bad-soft": "#3d1a18",
      "hero-bg": "#252525",
      "hero-ink": "#ffffff",
      "hero-muted": "#d5d5d5",
      "toast-bg": "#303030",
      "toast-ink": "#ffffff"
    },
    "light": {
      "bg": "#f5f5f7",
      "surface": "#ffffff",
      "surface-2": "#ececf0",
      "ink": "#1d1d1f",
      "muted": "#5c5c63",
      "line": "#cfcfd5",
      "accent": "#1d1d1f",
      "accent-ink": "#ffffff",
      "accent-soft": "#e8e8ed",
      "ok": "#1d7a3a",
      "ok-soft": "#e2f3e7",
      "warn": "#875700",
      "warn-soft": "#fbefd6",
      "pend": "#4a4a50",
      "pend-soft": "#ececf0",
      "bad": "#c42b1c",
      "bad-soft": "#fde8e6",
      "hero-bg": "#252525",
      "hero-ink": "#ffffff",
      "hero-muted": "#d5d5d5",
      "toast-bg": "#1d1d1f",
      "toast-ink": "#ffffff"
    }
  },
  "font": {
    "family": {
      "base": "'Montserrat', system-ui, -apple-system, 'Segoe UI', sans-serif"
    },
    "text": {
      "hero":       { "size": "clamp(40px, 7vw, 64px)",   "weight": 700, "line": 1.08, "tracking": "-0.02em" },
      "h2":         { "size": "clamp(28px, 4.4vw, 40px)", "weight": 700, "line": 1.15, "tracking": "-0.015em" },
      "h3":         { "size": "24px", "weight": 600, "line": 1.25, "tracking": "-0.01em" },
      "title":      { "size": "18px", "weight": 600, "line": 1.35, "tracking": "0" },
      "body-lg":    { "size": "18px", "weight": 400, "line": 1.55, "tracking": "0" },
      "body":       { "size": "16px", "weight": 400, "line": 1.5,  "tracking": "0" },
      "small":      { "size": "14px", "weight": 300, "line": 1.45, "tracking": "0" },
      "label":      { "size": "12px", "weight": 500, "line": 1.3,  "tracking": "0.08em" },
      "button":     { "size": "14px", "weight": 600, "line": 1.2,  "tracking": "0" },
      "nav":        { "size": "14px", "weight": 400, "line": 1.3,  "tracking": "0" }
    }
  },
  "space": {
    "0": "0px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px"
  },
  "radius": {
    "sm": "8px",
    "md": "12px",
    "lg": "18px",
    "xl": "24px",
    "pill": "999px"
  },
  "shadow": {
    "soft": "0 18px 46px rgba(0,0,0,.18)",
    "float": "0 24px 56px rgba(0,0,0,.3)"
  },
  "size": {
    "control": "40px",
    "touch": "44px",
    "page": "1160px",
    "read": "820px",
    "question": "560px",
    "side": "340px",
    "gutter": "16px"
  }
}
