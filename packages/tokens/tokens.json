{
  "$description": "Design tokens da MIP. Fonte única de cores, tipografia, espaçamento, raios e sombras. Rode `npm run tokens` para gerar dist/tokens.css e dist/tokens.js.",
  "color": {
    "dark": {
      "bg": "#0d0d0d",
      "surface": "#191919",
      "surface-2": "#292929",
      "ink": "#f5f5f5",
      "muted": "#b5b5b5",
      "line": "#505050",
      "accent": "#f5f5f5",
      "accent-ink": "#101010",
      "accent-soft": "#303030",
      "ok": "#6fd08c",
      "ok-soft": "#17331f",
      "warn": "#f0c060",
      "warn-soft": "#3a2e12",
      "pend": "#c9c9c9",
      "pend-soft": "#292929",
      "bad": "#ff8a80",
      "bad-soft": "#3d1a18",
      "hero-bg": "#252525",
      "hero-ink": "#ffffff",
      "hero-muted": "#d5d5d5",
      "toast-bg": "#303030",
      "toast-ink": "#ffffff"
    },
    "light": {
      "bg": "#f5f5f7",
      "surface": "#ffffff",
      "surface-2": "#ececf0",
      "ink": "#1d1d1f",
      "muted": "#5c5c63",
      "line": "#cfcfd5",
      "accent": "#1d1d1f",
      "accent-ink": "#ffffff",
      "accent-soft": "#e8e8ed",
      "ok": "#1d7a3a",
      "ok-soft": "#e2f3e7",
      "warn": "#875700",
      "warn-soft": "#fbefd6",
      "pend": "#4a4a50",
      "pend-soft": "#ececf0",
      "bad": "#c42b1c",
      "bad-soft": "#fde8e6",
      "hero-bg": "#252525",
      "hero-ink": "#ffffff",
      "hero-muted": "#d5d5d5",
      "toast-bg": "#1d1d1f",
      "toast-ink": "#ffffff"
    }
  },
  "font": {
    "family": {
      "base": "'Montserrat', system-ui, -apple-system, 'Segoe UI', sans-serif"
    },
    "text": {
      "$description": "Celular: escala do iOS (size/line). Computador, a partir de 768 px: escala do macOS (mac: [tamanho, entrelinha]). Valores em px; o build gera rem.",
      "large-title": { "size": 34, "line": 41, "weight": 700, "tracking": "-0.02em", "mac": [26, 32] },
      "title-1":     { "size": 28, "line": 34, "weight": 700, "tracking": "-0.015em", "mac": [22, 26] },
      "title-2":     { "size": 22, "line": 28, "weight": 700, "tracking": "-0.01em", "mac": [17, 22] },
      "title-3":     { "size": 20, "line": 25, "weight": 600, "tracking": "0", "mac": [15, 20] },
      "headline":    { "size": 17, "line": 22, "weight": 700, "tracking": "0", "mac": [13, 16] },
      "body":        { "size": 17, "line": 22, "weight": 400, "tracking": "0", "mac": [13, 16] },
      "callout":     { "size": 16, "line": 21, "weight": 400, "tracking": "0", "mac": [12, 15] },
      "subhead":     { "size": 15, "line": 20, "weight": 400, "tracking": "0", "mac": [11, 14] },
      "footnote":    { "size": 13, "line": 18, "weight": 400, "tracking": "0", "mac": [10, 13] },
      "caption-1":   { "size": 12, "line": 16, "weight": 400, "tracking": "0", "mac": [10, 13] },
      "caption-2":   { "size": 11, "line": 13, "weight": 400, "tracking": "0", "mac": [10, 13] }
    }
  },
  "space": {
    "0": "0px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px"
  },
  "radius": {
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "24px",
    "pill": "999px"
  },
  "shadow": {
    "soft": "0 18px 46px rgba(0,0,0,.18)",
    "float": "0 24px 56px rgba(0,0,0,.3)"
  },
  "size": {
    "control": "40px",
    "touch": "44px",
    "page": "1160px",
    "read": "820px",
    "question": "560px",
    "side": "340px",
    "gutter": "16px"
  }
}
