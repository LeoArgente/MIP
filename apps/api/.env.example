# Copie para apps/api/.env e ajuste.

# Banco PostgreSQL. Local: postgresql://SEU_USUARIO@localhost:5432/mip_dev
# Supabase: em Connect > ORMs > Prisma, copie DATABASE_URL (Transaction pooler, porta 6543)
DATABASE_URL="postgresql://localhost:5432/mip_dev"
# Migrações (criar/alterar tabelas). Local: igual a DATABASE_URL. Supabase: "Session pooler", porta 5432.
DIRECT_URL="postgresql://localhost:5432/mip_dev"

# Endereço público do site (usado nos links enviados por e-mail).
# Local com Vite: http://localhost:5173 · Online: https://seu-app.onrender.com
APP_URL="http://localhost:5173"

# ===== Envio de e-mail (login e convites) pela Resend: https://resend.com =====
# Crie uma conta, gere uma chave em API Keys e cole abaixo.
# Sem domínio verificado, a Resend só entrega no e-mail da própria conta Resend.
# Para mandar para qualquer pessoa, verifique um domínio em Domains e use um remetente dele em MAIL_FROM.
RESEND_API_KEY=""
MAIL_FROM="MIP <onboarding@resend.dev>"

# Só para testes locais: mostra "Entrar como" para trocar de pessoa sem e-mail.
# Nunca deixe 1 num site com dados reais.
DEV_LOGIN="1"

PORT=3001

# Versão de teste com usuários: entrar com nome e e-mail, sem confirmação por e-mail.
# Use 1 enquanto não houver domínio para enviar e-mails. Desligue (0) quando o envio funcionar.
TEST_LOGIN="1"
