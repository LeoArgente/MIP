// Banco de dados da MIP (PostgreSQL).
// As respostas e a proposta guardam JSON com o mesmo formato do protótipo,
// para que as regras em @mip/domain funcionem igual no servidor e no navegador.

generator client {
  provider        = "prisma-client-js"
  /**
   * Carrega o projeto com todas as relações numa consulta só (JOIN), em vez de uma consulta por tabela.
   */
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  // Conexão usada pelo app.
  // - Servidor contínuo (computador local): "Session pooler" (porta 5432) com ?connection_limit=5.
  // - Vercel (funções que ligam a cada pedido): "Transaction pooler" (porta 6543) com ?pgbouncer=true&connection_limit=1.
  url       = env("DATABASE_URL")
  // Conexão usada para criar e alterar tabelas (migrações). No Supabase: "Session pooler" (porta 5432).
  // Local, use o mesmo valor de DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String
  seenWelcome Boolean  @default(false)
  createdAt   DateTime @default(now())

  sessions      Session[]
  memberships   Member[]
  organizes     Project[]      @relation("Organizer")
  answers       Answer[]
  comments      Comment[]
  confirmations Confirmation[]
  feedbacks     Feedback[]
}

/// Link de acesso por e-mail (guardamos só o hash do token).
model LoginToken {
  id        String    @id @default(cuid())
  email     String
  name      String?
  tokenHash String    @unique
  next      String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Project {
  id           String   @id @default(cuid())
  name         String
  context      String   @default("")
  orgId        String
  org          User     @relation("Organizer", fields: [orgId], references: [id])
  /// coleta | encerrada | decisao | confirmacao | consolidado
  phase        String   @default("coleta")
  /// equipe | ativos | resp
  setupStep    String   @default("equipe")
  inviteCode   String   @unique
  inviteActive Boolean  @default(true)
  /// Sobre o projeto (quem organiza responde): contas, acordo, edital
  sobre        Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members   Member[]
  assets    Asset[]
  answers   Answer[]
  proposals Proposal[]
  versions  Version[]
  comments  Comment[]
  history   HistoryEntry[]
  memorials Memorial[]
}

model Member {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// ativo | pendente | naopart
  status    String    @default("ativo")
  /// Responde nesta rodada (entrou antes do fim das respostas)
  elig      Boolean   @default(true)
  removedBy String?
  removedAt DateTime?
  /// Sobre a pessoa (ela mesma responde): função e se investiu dinheiro
  perfil    Json      @default("{}")
  createdAt DateTime  @default(now())

  @@unique([projectId, userId])
}

/// Criação (ativo) do projeto.
model Asset {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  type        String
  cat         String
  desc        String   @default("")
  link        String   @default("")
  /// ok | sug | rec
  status      String   @default("ok")
  suggestedBy String?
  reason      String?
  createdAt   DateTime @default(now())

  answers  Answer[]
  proposal Proposal?
  comments Comment[]
}

model Answer {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assetId   String
  asset     Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  draft     Json      @default("{}")
  sent      Json?
  sentAt    DateTime?
  /// Tela em que a pessoa parou (para "Continuar")
  step      Int       @default(0)
  updatedAt DateTime  @updatedAt

  @@unique([assetId, userId])
}

/// Proposta de quem organiza para uma criação.
model Proposal {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assetId   String   @unique
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  /// { v, externo, percentual, texto, semAcordo, saved, by, at, ajuste }
  data      Json
  updatedAt DateTime @updatedAt
}

/// Versão enviada para confirmação (cópia congelada da proposta).
model Version {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  n         Int
  snap      Json
  createdAt DateTime @default(now())

  confirmations Confirmation[]

  @@unique([projectId, n])
}

model Confirmation {
  id        String   @id @default(cuid())
  versionId String
  version   Version  @relation(fields: [versionId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// ok | no
  value     String
  comment   String   @default("")
  /// Criações em que a pessoa pediu ajuste (na recusa)
  assets    Json     @default("[]")
  createdAt DateTime @default(now())

  @@unique([versionId, userId])
}

model Comment {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())
}

model HistoryEntry {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// null = sistema
  userId    String?
  text      String
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

/// Registro do acordo gerado, com o código de verificação.
model Memorial {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  body      String
  hash      String
  createdAt DateTime @default(now())

  @@index([hash])
}

/// Feedback para a equipe da MIP: comentário livre (botão "Feedback", em qualquer tela)
/// ou nota de satisfação de 1 (muito ruim) a 5 (muito bom), dada ao ver o registro do acordo.
model Feedback {
  id        String          @id @default(cuid())
  kind      String // "texto" ou "satisfacao"
  rating    Int?
  text      String?
  screen    String // onde a pessoa estava, em palavras ("Decisões · Logo · ponto 2")
  path      String
  device    String? // "celular" ou "computador"
  projectId String?
  userId    String?
  user      User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  images    FeedbackImage[]
  createdAt DateTime        @default(now())

  @@index([createdAt])
  @@index([userId, projectId, kind])
}

/// Print anexado a um feedback (já reduzido no navegador). Fica à parte para a lista do /admin não carregar as imagens.
model FeedbackImage {
  id         String   @id @default(cuid())
  feedbackId String
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  mime       String
  data       Bytes
  createdAt  DateTime @default(now())

  @@index([feedbackId])
}
