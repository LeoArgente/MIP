  },
  "dependencies": {
    "@mip/domain": "*",
    "@prisma/client": "^6.6.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "prisma": "^6.6.0"
  }
}
